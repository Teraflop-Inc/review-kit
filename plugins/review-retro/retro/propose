#!/usr/bin/env python3
"""retro/propose: open a PR proposing rule changes. Never writes to the default branch.

Deterministic, no LLM. Reads the `changes` list from the analysis, applies it to the
rules file as it exists on the default branch, and opens a PR from a new
`review-retro/...` branch with the rules file (and, per repo, the knowledge base).

  retro/propose --repo owner/name --analysis analysis.json --digest DIR --kb retro/issues.md
  retro/propose --repo aowen14/review-kit --file prompts/base-review.md \
                --analysis cross.json --min-repos 2          # cross-repo: kit base prompt

Every change must cite PRs: ints (#N in --repo, and in the scanned set when --digest is
given) or "owner/name#N" strings. With --min-repos K, each change must cite PRs from at
least K distinct repos. Changes that fail validation are dropped and listed in the PR body.
Use --dry-run to print the diff and PR body without touching GitHub.
"""
import argparse
import base64
import datetime as dt
import difflib
import json
from pathlib import Path
import os
import re
import sys

sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
from _gh import GhError, rest, split_repo  # noqa: E402

BRANCH_PREFIX = "review-retro/"
ADD_SECTION = "## Proposed by review-retro"
CITE_RE = re.compile(r"\s*\(retro: [^)]*\)\s*$")


def parse_pr(ref, repo):
    """Return (repo, number) for 12, "#12", or "owner/name#12"."""
    s = str(ref).strip()
    m = re.fullmatch(r"(?:([\w.-]+/[\w.-]+))?#?(\d+)", s)
    if not m:
        raise ValueError(f"bad PR reference {ref!r}")
    return (m.group(1) or repo), int(m.group(2))


def cite(refs, repo):
    return ", ".join(f"#{n}" if r == repo else f"{r}#{n}" for r, n in refs)


def validate(changes, repo, scanned, min_repos):
    ok, dropped = [], []
    for c in changes:
        op = c.get("op")
        try:
            refs = sorted({parse_pr(p, repo) for p in c.get("prs", [])})
        except ValueError as e:
            dropped.append((c, str(e)))
            continue
        why = None
        if op not in ("add", "change", "remove"):
            why = f"unknown op {op!r}"
        elif not refs:
            why = "cites no PR"
        elif scanned is not None and any(r == repo and n not in scanned for r, n in refs):
            why = "cites a PR outside the scanned set"
        elif min_repos and len({r for r, _ in refs}) < min_repos:
            why = f"cites PRs from fewer than {min_repos} repos"
        elif op in ("add", "change") and not c.get("text", "").strip():
            why = "missing rule text"
        elif op in ("change", "remove") and not c.get("old", "").strip():
            why = "missing the existing rule text (old)"
        if why:
            dropped.append((c, why))
        else:
            ok.append({**c, "refs": refs})
    return ok, dropped


def _norm(s):
    return re.sub(r"\s+", " ", CITE_RE.sub("", s.strip().lstrip("-* ").strip())).lower()


def apply(text, changes, repo):
    """Apply changes to markdown rules. Returns (new_text, applied, not_found)."""
    lines = (text or "").splitlines()
    applied, missing = [], []
    for c in changes:
        rule = f"- {c.get('text', '').strip()} (retro: {cite(c['refs'], repo)})"
        if c["op"] in ("change", "remove"):
            idx = next((i for i, ln in enumerate(lines)
                        if re.match(r"^\s*[-*] ", ln) and _norm(ln) == _norm(c["old"])), None)
            if idx is None:
                missing.append((c, "existing rule text not found"))
                continue
            if c["op"] == "remove":
                del lines[idx]
            else:
                lines[idx] = rule
            applied.append(c)
            continue
        section = (c.get("section") or "").strip().lstrip("# ").lower()
        head = next((i for i, ln in enumerate(lines)
                     if ln.startswith("#") and section and ln.lstrip("# ").strip().lower() == section), None)
        if head is None:
            if ADD_SECTION not in lines:
                lines += (["", ADD_SECTION] if lines else [ADD_SECTION])
            head = lines.index(ADD_SECTION)
        end = head + 1
        while end < len(lines) and not lines[end].startswith("#"):
            end += 1
        while end > head + 1 and not lines[end - 1].strip():
            end -= 1
        lines.insert(end, rule)
        if end == head + 1:
            lines.insert(end, "")
        applied.append(c)
    return "\n".join(lines).rstrip() + "\n", applied, missing


def get_file(owner, name, path, ref):
    try:
        data, _ = rest(f"repos/{owner}/{name}/contents/{path}?ref={ref}")
        return base64.b64decode(data["content"]).decode(), data["sha"]
    except GhError as e:
        if "404" in str(e) or "Not Found" in str(e):
            return None, None
        raise


def put_file(owner, name, path, branch, default, content, msg):
    if branch == default or not branch.startswith(BRANCH_PREFIX):
        raise SystemExit(f"refusing to write {path} to {branch!r}: review-retro only writes to {BRANCH_PREFIX}* branches")
    _, sha = get_file(owner, name, path, branch)
    body = {"message": msg, "branch": branch, "content": base64.b64encode(content.encode()).decode()}
    if sha:
        body["sha"] = sha
    rest(f"repos/{owner}/{name}/contents/{path}", method="PUT", body=body)


def pr_body(a, applied, dropped, repo, meta, analysis):
    L = ["Proposed by **review-retro** (review-kit). Every rule below cites the PRs whose review threads justify it. "
         f"Nothing here is merged automatically; `{a.file}` on the default branch is untouched until a human merges this PR.", ""]
    if meta:
        s = meta["sizes"]
        nums = [p["number"] for p in meta["prs"]]
        L += [f"**Scanned:** {len(nums)} merged PRs" + (f" (#{min(nums)}–#{max(nums)})" if nums else "") +
              f", {meta['records']} review threads. Outcomes: " +
              ", ".join(f"{k} {v}" for k, v in meta["by_outcome"].items()) + ". Reviewers: " +
              ", ".join(f"{k} {v}" for k, v in meta["by_author"].items()) + ".",
              f"**Digest size:** {s['digest_bytes']:,} bytes vs {s['raw_bytes']:,} bytes of raw API responses "
              f"({s['raw_review_bytes']:,} review data + {s['raw_compare_bytes']:,} commit compares).", ""]
    if a.new_file and a.base_file:
        L += [f"`{a.file}` does not exist on the default branch yet. This PR creates it from `{a.base_file}` "
              "plus the changes below; review the starter rules as well.", ""]
    if analysis.get("summary"):
        L += [analysis["summary"], ""]
    L += [f"### Proposed changes to `{a.file}`", ""]
    if applied:
        L += ["| Change | Rule | Cited PRs | Why |", "|---|---|---|---|"]
        for c in applied:
            rule = (c.get("text") or c.get("old", "")).replace("|", "\\|")
            if c["op"] == "change":
                rule = f"~~{c['old']}~~ → {rule}".replace("|", "\\|")
            L.append(f"| {c['op']} | {rule} | {cite(c['refs'], repo)} | {c.get('why', '').replace('|', '/')} |")
    else:
        L.append("No rule changes this run; this PR only updates the knowledge base.")
    if dropped:
        L += ["", "<details><summary>Dropped proposals (failed validation)</summary>", ""]
        L += [f"- {c.get('op')} `{(c.get('text') or c.get('old') or '')[:80]}`: {why}" for c, why in dropped]
        L += ["", "</details>"]
    if a.kb:
        L += ["", "The knowledge base `retro/issues.md` is updated in this PR too, so the next run builds on it."]
    return "\n".join(L)


def main(argv=None):
    ap = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    ap.add_argument("--repo", required=True, help="repo the PR is opened against")
    ap.add_argument("--analysis", required=True)
    ap.add_argument("--file", default="REVIEW.md", help="rules file to change")
    ap.add_argument("--digest", default=None, help="digest dir; restricts citations to scanned PRs")
    ap.add_argument("--kb", default=None, help="local knowledge base to commit as retro/issues.md")
    ap.add_argument("--min-repos", type=int, default=0)
    ap.add_argument("--base-file", default=None, help="use this local file as the current rules (no REVIEW.md yet)")
    ap.add_argument("--title", default=None)
    ap.add_argument("--dry-run", action="store_true")
    a = ap.parse_args(argv)

    owner, name = split_repo(a.repo)
    analysis = json.loads(Path(a.analysis).read_text())
    meta, scanned = None, None
    if a.digest:
        meta = json.loads(Path(a.digest, "meta.json").read_text())
        scanned = {p["number"] for p in meta["prs"]}
    changes, dropped = validate(analysis.get("changes", []), a.repo, scanned, a.min_repos)

    info, _ = rest(f"repos/{owner}/{name}")
    default = info["default_branch"]
    current, _ = get_file(owner, name, a.file, default)
    a.new_file = current is None
    if current is None and a.base_file:
        current = Path(a.base_file).read_text()
    new, applied, missing = apply(current or "", changes, a.repo)
    dropped += missing
    diff = "".join(difflib.unified_diff((current or "").splitlines(True), new.splitlines(True),
                                        f"a/{a.file}", f"b/{a.file}"))
    body = pr_body(a, applied, dropped, a.repo, meta, analysis)
    kind = "cross-repo patterns" if a.min_repos >= 2 else f"{len(applied)} rule change(s)"
    title = a.title or f"review-retro: {kind} for {a.file}"
    if a.dry_run or (not applied and not a.kb):
        print(diff or f"(no changes to {a.file})")
        print("\n---\n" + body)
        if not a.dry_run:
            print("retro: nothing to propose", file=sys.stderr)
        return

    stamp = dt.datetime.now(dt.timezone.utc).strftime("%Y%m%d-%H%M%S")
    branch = f"{BRANCH_PREFIX}{'cross-' if a.min_repos >= 2 else ''}{stamp}"
    ref, _ = rest(f"repos/{owner}/{name}/git/ref/heads/{default}")
    rest(f"repos/{owner}/{name}/git/refs", method="POST",
         body={"ref": f"refs/heads/{branch}", "sha": ref["object"]["sha"]})
    if applied:
        put_file(owner, name, a.file, branch, default, new, f"review-retro: propose {a.file} changes")
    if a.kb:
        put_file(owner, name, "retro/issues.md", branch, default, Path(a.kb).read_text(),
                 "review-retro: update knowledge base")
    older = [] if a.min_repos >= 2 else [p for p in rest(f"repos/{owner}/{name}/pulls?state=open&per_page=100")[0]
                                         if p["head"]["ref"].startswith(BRANCH_PREFIX)
                                         and not p["head"]["ref"].startswith(BRANCH_PREFIX + "cross-")]
    pr, _ = rest(f"repos/{owner}/{name}/pulls", method="POST",
                 body={"title": title, "head": branch, "base": default, "body": body})
    for p in older:   # the new PR carries the older PR's knowledge base forward
        rest(f"repos/{owner}/{name}/issues/{p['number']}/comments", method="POST",
             body={"body": f"Superseded by #{pr['number']} (review-retro carries this knowledge base forward)."})
        rest(f"repos/{owner}/{name}/pulls/{p['number']}", method="PATCH", body={"state": "closed"})
    print(json.dumps({"pr": pr["html_url"], "branch": branch, "applied": len(applied), "dropped": len(dropped),
                      "superseded": [p["number"] for p in older]}))


if __name__ == "__main__":
    main()
